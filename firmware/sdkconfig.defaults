CONFIG_IDF_TARGET="esp32s3"

# FORIOT ESP32-S3-CAM, WROOM-1 N16R8: 16 MB quad flash, 8 MB octal PSRAM.
# The CH340 on the TTL port drops above 115200.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Logs go out UART0 (GPIO43/44) to the TTL port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Wi-Fi setup and the HTTP client need more than the 3584-byte default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Segment names do not fit 8.3 FAT names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
