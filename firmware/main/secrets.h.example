#pragma once

/*
 * Secrets template for the Gizmonic Cambot bring-up firmware.
 *
 * Setup:
 *   1. Copy this file to secrets.h in the same directory:
 *        cp firmware/main/secrets.h.example firmware/main/secrets.h
 *   2. Fill every REQUIRED value below for your network and host.
 *   3. Keep secrets.h out of git (it is gitignored). Never commit it,
 *      print it, or paste it into chat.
 *
 * The same camera password must also be available to the registrar as
 * CAMBOT_CAMERA_PASSWORD (environment or fixr/run/secrets.env).
 */

/* === REQUIRED ============================================================ */

/* 2.4 GHz Wi-Fi SSID (WPA2 or WPA3 Personal). Ask the user; do not guess. */
#define CAMBOT_WIFI_SSID "your-ssid"

/* Wi-Fi password for that SSID. Prefer setting it from a hidden prompt or
 * env at setup time; do not log the value. */
#define CAMBOT_WIFI_PASSWORD "your-wifi-password"

/* Bearer token the camera expects on its HTTP API (Authorization: Bearer …).
 * Pick a long random string. Use the same value as CAMBOT_CAMERA_PASSWORD
 * on the host running fixr/registrar/serve.py. */
#define CAMBOT_CAMERA_PASSWORD "your-camera-password"

/* Full URL the camera POSTs to when it joins the LAN. Replace the host with
 * this computer's current LAN IPv4 (the registrar prints it on startup):
 *   http://<host-lan-ip>:8765/api/register
 * Detect the address at setup time; do not reuse a stale profile IP. */
#define CAMBOT_REGISTRAR_URL "http://192.168.1.10:8765/api/register"

/* IANA time zone for on-device timestamps (for example America/Los_Angeles).
 * On the host, set the same zone with CAMBOT_TZ or TZ for the registrar. */
#define CAMBOT_TZ "America/Los_Angeles"

/* === OPTIONAL (indexing) ================================================= */

/* OpenAI-compatible API key for on-device GPT captions. Leave empty ("") to
 * record without GPT indexing. Also available on the host as CAMBOT_MODEL_KEY
 * for registrar ask. */
#define CAMBOT_MODEL_KEY ""

/* TypeSafe / JEV API key for on-device watch scores. Leave empty to disable. */
#define CAMBOT_JEV_KEY ""

/* Optional Anthropic key if you wire that path; unused when empty. */
#define CAMBOT_ANTHROPIC_KEY ""
